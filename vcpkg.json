{
  "name": "den-of-iz",
  "version": "0.0.1",
  "dependencies": [
    "cgltf",
    {
      "name": "wil",
      "platform": "windows"
    },
    "miniz",
    "spdlog",
    "stb",
    {
      "name": "volk",
      "platform": "windows|linux"
    },
    {
      "name": "vulkan",
      "platform": "windows|linux"
    },
    {
      "name": "vulkan-memory-allocator",
      "platform": "windows|linux"
    },
    "gtest",
    "directxmath",
    {
      "name": "harfbuzz",
      "default-features": false
    },
    "sheenbidi",
    "libunibreak",
    "yoga",
    {
      "name": "imgui",
      "features": [
        "docking-experimental"
      ]
    },
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ],
      "platform": "!osx"
    },
    {
      "name": "sdl3",
      "platform": "osx"
    },
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
    },
    {
      "name": "directx-headers",
      "platform": "windows|linux"
    }
  ],
  "features": {
    "examples": {
      "description": "Build examples with additional asset import support",
      "dependencies": [
        "assimp"
      ]
    },
    "pix": {
      "description": "Enable PIX profiler support",
      "dependencies": [
        {
          "name": "winpixevent",
          "platform": "windows"
        }
      ]
    }
  }
}

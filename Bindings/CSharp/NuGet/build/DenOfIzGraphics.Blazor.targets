<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <DenOfIzWasmDir>$(MSBuildThisFileDirectory)..\runtimes\browser-wasm\native\</DenOfIzWasmDir>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sUSE_WEBGPU=1 -sASYNCIFY=1 -sALLOW_MEMORY_GROWTH=1 -sTOTAL_MEMORY=536870912</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(DenOfIzWasmDir)libDenOfIzGraphics.a')">
    <NativeFileReference Include="$(DenOfIzWasmDir)libDenOfIzGraphics.a" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DenOfIzWasmDir)DenOfIzGraphics.js')">
    <Content Include="$(DenOfIzWasmDir)DenOfIzGraphics.js"
             Link="wwwroot\_content\DenOfIzGraphics\DenOfIzGraphics.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

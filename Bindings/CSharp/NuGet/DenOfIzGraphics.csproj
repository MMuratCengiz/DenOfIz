<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DenOfIzGraphicsCSharp</AssemblyName>
    <RootNamespace>DenOfIz.Bindings</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>DenOfIzGraphics</PackageId>
    <Version>0.6.1-alpha</Version>
    <Authors>Den Of Iz</Authors>
    <Company>Den Of Iz</Company>
    <Product>DenOfIz Graphics</Product>
    <Description>Cross-platform graphics abstraction library with C# bindings. Supports DirectX12, Vulkan, and Metal backends.</Description>
    <PackageTags>graphics;DirectX12;Vulkan;Metal;rendering;3D;game-development</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MartinJespersen/DenOfIz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MartinJespersen/DenOfIz.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Generated\**\*.cs" Link="Generated\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Wrappers\**\*.cs" Link="Wrappers\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Runtime\**\*.cs" Link="Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>